[Unit]
Description=Aroma Jiwa Hadir (PWA + API)
After=network.target

[Service]
Type=simple
User=ubuntu
WorkingDirectory=/opt/aroma
Environment=HOST=127.0.0.1
Environment=PORT=4000
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 run.py
Restart=always
RestartSec=3
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target

# Pasang manual (folder /opt/aroma):
#   sudo cp deploy/aroma-jiwa.service /etc/systemd/system/
#   sudo systemctl daemon-reload
#   sudo systemctl enable --now aroma-jiwa
#   sudo journalctl -u aroma-jiwa -f
#
# deploy/setup.sh menimpa baris User= dan WorkingDirectory= mengikuti pengguna
# sudo dan folder tempat skrip dijalankan (mis. ~/aroma).
